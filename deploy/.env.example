# Docker Compose overrides for building/publishing the image.
# Copy to `.env` (in this deploy/ directory) and edit to change the defaults.
# docker compose reads deploy/.env automatically.

# Docker Hub image repository (without the tag). docker.io is the default
# registry, so `nawitech/kotlin-fhirpath` and the full path are equivalent.
IMAGE=docker.io/nawitech/kotlin-fhirpath

# Image tag to build/push/deploy. Bump to a version (e.g. v1.2.0) to publish
# and deploy a specific release instead of the moving `latest` tag.
TAG=latest
